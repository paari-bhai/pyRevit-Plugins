<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Model Health" Width="1060" Height="640" MinWidth="820" MinHeight="420"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="12" Background="#F4F5F7">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#1F7A8C"/>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DADDE1" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="btn_rescan" Content="Rescan"/>
                    <Button x:Name="btn_close" Content="Close" MinWidth="80"/>
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Model Health" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                        <TextBlock x:Name="tb_model" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#5F6670"/>
                    </StackPanel>
                    <TextBlock x:Name="tb_summary" Margin="0,4,0,0" Foreground="#3C4148"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DADDE1" BorderThickness="0,1,0,0" Padding="10,6">
            <TextBlock TextWrapping="Wrap" Foreground="#5F6670"
                       Text="Fixes that delete anything show you the list first, so you can untick items. Each item is deleted on its own and skipped if Revit would delete anything else with it. Everything happens in one undoable step (Ctrl+Z)."/>
        </Border>
        <DataGrid x:Name="dg_findings" Margin="8" AutoGenerateColumns="False" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E3E5E8"
                  Background="White" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding level}" Value="Fix">
                            <Setter Property="Background" Value="#FDECEC"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding level}" Value="Watch">
                            <Setter Property="Background" Value="#FFF6E0"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding level}" Value="OK">
                            <Setter Property="Background" Value="#EEF8F1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Status" Binding="{Binding level}" Width="60"/>
                <DataGridTextColumn Header="Check" Binding="{Binding check}" Width="200"/>
                <DataGridTextColumn Header="Value" Binding="{Binding value}" Width="90"/>
                <DataGridTemplateColumn Header="Advice" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding advice}" TextWrapping="Wrap" Margin="4,4"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Action" Width="230">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding fix_label}" Visibility="{Binding fix_visibility}"
                                    Click="fix_clicked" HorizontalAlignment="Left" Margin="4"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
